# Serves the single-page app and proxies /api to the API, so the browser sees one origin
# (cookies stay first-party and no CORS is needed). Rendered with envsubst at container start.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;

  # The API sets its own strict headers; the app's are set here.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  # Terminate TLS in front of this container (load balancer or ingress) and keep this header on.
  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    # server-sent events (streamed chat answers) must not be buffered
    proxy_buffering off;
    proxy_read_timeout 180s;
    client_max_body_size ${MAX_UPLOAD};
    proxy_request_buffering off;
    # declaring any add_header here stops the server-level ones being added on top of the API's own (helmet) headers
    add_header X-Accel-Buffering "no" always;
  }

  location = /healthz { access_log off; return 200 "ok\n"; }

  # fingerprinted build output never changes
  location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; add_header X-Content-Type-Options "nosniff" always; try_files $uri =404; }

  location / {
    add_header Cache-Control "no-cache";
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    try_files $uri /index.html;
  }
}
