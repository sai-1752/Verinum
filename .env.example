# Used by docker-compose.yml. Copy to .env and change every value marked CHANGE.
# Compose reads this file only to fill in the values listed under each service's `environment:`; the API container
# receives just the variables it needs and never the Postgres superuser or schema-owner passwords.
# Generate secrets with:  openssl rand -hex 24      (keep them alphanumeric: they are placed in URLs)

# --- database (three passwords: the Postgres superuser, the schema owner, the API's runtime role) ---
POSTGRES_PASSWORD=CHANGE
VN_OWNER_PASSWORD=CHANGE
VN_APP_PASSWORD=CHANGE

# --- public address of the app (https in production; cookies are Secure) ---
PUBLIC_WEB_URL=https://analytics.example.com
PUBLIC_API_URL=https://analytics.example.com
COOKIE_SECURE=true
# signs short-lived OAuth state cookies:  openssl rand -hex 32
COOKIE_SECRET=CHANGE
# encrypts every stored upload at rest (AES-256-GCM, 32 bytes, base64):  openssl rand -base64 32
STORAGE_ENCRYPTION_KEY=CHANGE

# --- email (verification, password reset, invitations) ---
MAIL_DRIVER=smtp
SMTP_URL=smtp://user:password@smtp.example.com:587
MAIL_FROM=Verinum <no-reply@example.com>
REQUIRE_EMAIL_VERIFICATION=false

# --- the AI analyst (optional: without it every answer is the deterministic, computed one) ---
AI_PROVIDER=none
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# --- Google sign-in (optional) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- billing (optional) ---
BILLING_PROVIDER=none
# BILLING_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_TEAM=

# --- operations ---
LOG_LEVEL=info
# protects /metrics; when unset the endpoint is disabled
# METRICS_TOKEN=CHANGE
WEB_PORT=8080

# --- object storage (default: a Docker volume on the API container) ---
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=            # only for S3-compatible services (MinIO, R2, …)
# S3_FORCE_PATH_STYLE=false

# --- sizing ---
# ALLOW_REGISTRATION=true
# WORKER_CONCURRENCY=2
# FRAME_CACHE_MB=512
