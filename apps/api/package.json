{
  "name": "@verinum/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:workers -w @verinum/ingest && tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.mjs",
    "build": "node scripts/build.mjs",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@verinum/core": "*",
    "@verinum/ingest": "*",
    "fastify": "^5.1.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.0.0"
  }
}
