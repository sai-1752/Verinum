# Local development. Copy to apps/api/.env  (npm run dev / npm run migrate load it automatically).
# Every value has a working development default, so this file is optional; it lists what you can change.
# Production settings are validated at start-up and the server refuses to run with unsafe ones (see docs/DEPLOYMENT.md).

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# Two roles: the owner runs migrations; the app role is what the running API uses (no BYPASSRLS, owns nothing).
# Create both with:  ./scripts/db-bootstrap.sh
DATABASE_URL=postgres://verinum_app:app_dev_pw@127.0.0.1:5432/verinum
DATABASE_MIGRATION_URL=postgres://verinum_owner:owner_dev_pw@127.0.0.1:5432/verinum

# Mail is logged to the console by default. Use `file` to write each message to ./mail-outbox as JSON.
MAIL_DRIVER=log
# MAIL_FILE_DIR=./mail-outbox

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-data
# STORAGE_ENCRYPTION_KEY=          # base64, 32 bytes. Optional in development, required in production.

# AI: none = deterministic answers only.
AI_PROVIDER=none
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1

ALLOW_REGISTRATION=true
REQUIRE_EMAIL_VERIFICATION=false
WORKER_ENABLED=true

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
BILLING_PROVIDER=none
